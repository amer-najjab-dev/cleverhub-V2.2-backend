generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model alerts {
  id          Int       @id @default(autoincrement())
  alert_type  String?   @db.VarChar(30)
  product_id  Int?
  lot_id      Int?
  title       String    @db.VarChar(255)
  message     String
  priority    String?   @default("medium") @db.VarChar(20)
  is_read     Boolean?  @default(false)
  is_resolved Boolean?  @default(false)
  resolved_by Int?
  resolved_at DateTime? @db.Timestamp(6)
  data        Json?
  created_at  DateTime? @default(now()) @db.Timestamp(6)
}

model categories {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(100)
  description String?
  parent_id   Int?
  level       Int?      @default(1)
  sort_order  Int?      @default(0)
  created_at  DateTime? @default(now()) @db.Timestamp(6)
}

model client_debts {
  id                Int       @id @default(autoincrement())
  client_id         Int?
  total_debt        Decimal   @default(0) @db.Decimal(10, 2)
  paid_amount       Decimal   @default(0) @db.Decimal(10, 2)
  pending_amount    Decimal?  @default(dbgenerated("(total_debt - paid_amount)")) @db.Decimal(10, 2)
  last_payment_date DateTime? @db.Timestamp(6)
  status            String?   @default("pending") @db.VarChar(20)
  notes             String?
  created_at        DateTime? @default(now()) @db.Timestamp(6)
  updated_at        DateTime? @default(now()) @db.Timestamp(6)
  clients           clients?  @relation(fields: [client_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([client_id], map: "idx_client_debts_client_id")
}

model clients {
  id                 Int            @id @default(autoincrement())
  first_name         String         @db.VarChar(100)
  last_name          String         @db.VarChar(100)
  email              String?        @unique @db.VarChar(255)
  phone              String?        @db.VarChar(20)
  address            String?
  dni                String?        @unique @db.VarChar(20)
  birth_date         DateTime?      @db.Date
  allergies          String?
  chronic_conditions String?
  is_pregnant        Boolean?       @default(false)
  is_lactating       Boolean?       @default(false)
  loyalty_points     Int?           @default(0)
  total_purchases    Decimal?       @default(0) @db.Decimal(10, 2)
  favorite           Boolean?       @default(false)
  notes              String?
  created_at         DateTime?      @default(now()) @db.Timestamp(6)
  updated_at         DateTime?      @default(now()) @db.Timestamp(6)
  client_debts       client_debts[]
  sales              sales[]
}

model delivery_note_items {
  id                Int              @id @default(autoincrement())
  delivery_note_id  Int?
  product_id        Int?
  quantity          Int
  unit_cost_pph     Decimal          @db.Decimal(10, 2)
  suggested_ppv     Decimal?         @db.Decimal(10, 2)
  expiration_date   DateTime         @db.Date
  batch_number      String?          @db.VarChar(100)
  subtotal          Decimal?         @default(dbgenerated("((quantity)::numeric * unit_cost_pph)")) @db.Decimal(10, 2)
  margin_percentage Decimal?         @db.Decimal(5, 2)
  notes             String?
  created_at        DateTime?        @default(now()) @db.Timestamp(6)
  delivery_notes    delivery_notes?  @relation(fields: [delivery_note_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  inventory_lots    inventory_lots[]
}

model delivery_notes {
  id                  Int                   @id @default(autoincrement())
  note_number         String                @unique @db.VarChar(50)
  supplier_id         Int?
  bl_number           String?               @db.VarChar(100)
  reception_date      DateTime              @db.Date
  reception_time      DateTime?             @db.Time(6)
  total_amount        Decimal?              @default(0) @db.Decimal(10, 2)
  total_items         Int?                  @default(0)
  payment_status      String?               @default("pending") @db.VarChar(20)
  is_paid             Boolean?              @default(false)
  paid_amount         Decimal?              @default(0) @db.Decimal(10, 2)
  paid_date           DateTime?             @db.Timestamp(6)
  notes               String?
  received_by         Int?
  created_at          DateTime?             @default(now()) @db.Timestamp(6)
  updated_at          DateTime?             @default(now()) @db.Timestamp(6)
  delivery_note_items delivery_note_items[]
  users               users?                @relation(fields: [received_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  suppliers           suppliers?            @relation(fields: [supplier_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
}

model employees {
  id                Int       @id @default(autoincrement())
  user_id           Int?
  employee_code     String?   @unique @db.VarChar(50)
  hire_date         DateTime  @db.Date
  termination_date  DateTime? @db.Date
  salary            Decimal?  @db.Decimal(10, 2)
  bank_account      String?   @db.VarChar(100)
  emergency_contact String?
  documents         Json?
  notes             String?
  created_at        DateTime? @default(now()) @db.Timestamp(6)
  updated_at        DateTime? @default(now()) @db.Timestamp(6)
  users             users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model exchange_items {
  id             Int        @id @default(autoincrement())
  exchange_id    Int?
  product_id     Int?
  direction      String?    @db.VarChar(10)
  quantity       Int
  unit_price_ppv Decimal    @db.Decimal(10, 2)
  unit_price_pph Decimal    @db.Decimal(10, 2)
  subtotal       Decimal?   @default(dbgenerated("((quantity)::numeric * unit_price_ppv)")) @db.Decimal(10, 2)
  notes          String?
  created_at     DateTime?  @default(now()) @db.Timestamp(6)
  exchanges      exchanges? @relation(fields: [exchange_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model exchanges {
  id                   Int              @id @default(autoincrement())
  exchange_number      String           @unique @db.VarChar(50)
  pharmacy_id          Int?
  pharmacy_name        String           @db.VarChar(255)
  contact_person       String?          @db.VarChar(100)
  phone                String?          @db.VarChar(20)
  total_value_offered  Decimal?         @default(0) @db.Decimal(10, 2)
  total_value_received Decimal?         @default(0) @db.Decimal(10, 2)
  balance              Decimal?         @default(dbgenerated("(total_value_received - total_value_offered)")) @db.Decimal(10, 2)
  payment_status       String?          @default("pending") @db.VarChar(20)
  exchange_status      String?          @default("pending") @db.VarChar(20)
  notes                String?
  created_by           Int?
  created_at           DateTime?        @default(now()) @db.Timestamp(6)
  updated_at           DateTime?        @default(now()) @db.Timestamp(6)
  exchange_items       exchange_items[]
  users                users?           @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model inventory_lots {
  id                    Int                  @id @default(autoincrement())
  product_id            Int?
  delivery_note_item_id Int?
  batch_number          String?              @db.VarChar(100)
  quantity              Int
  available_quantity    Int
  unit_cost_pph         Decimal              @db.Decimal(10, 2)
  expiration_date       DateTime             @db.Date
  zone                  String?              @db.VarChar(50)
  shelf_location        String?              @db.VarChar(100)
  status                String?              @default("active") @db.VarChar(20)
  is_paid               Boolean?             @default(false)
  notes                 String?
  created_at            DateTime?            @default(now()) @db.Timestamp(6)
  updated_at            DateTime?            @default(now()) @db.Timestamp(6)
  delivery_note_items   delivery_note_items? @relation(fields: [delivery_note_item_id], references: [id], onUpdate: NoAction)
  stock_movements       stock_movements[]
}

model logs {
  id          Int       @id @default(autoincrement())
  user_id     Int?
  action      String    @db.VarChar(100)
  entity_type String?   @db.VarChar(50)
  entity_id   Int?
  old_values  Json?
  new_values  Json?
  ip_address  String?   @db.VarChar(45)
  user_agent  String?
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  users       users?    @relation(fields: [user_id], references: [id], onUpdate: NoAction)
}

model organization {
  id                  Int       @id @default(autoincrement())
  pharmacy_name       String    @db.VarChar(255)
  tax_id              String    @db.VarChar(50)
  address             String
  phone               String?   @db.VarChar(20)
  email               String?   @db.VarChar(255)
  license_number      String?   @db.VarChar(100)
  license_expiry      DateTime? @db.Date
  logo_url            String?
  currency            String?   @default("EUR") @db.VarChar(3)
  tax_rate            Decimal?  @default(21.00) @db.Decimal(5, 2)
  low_stock_threshold Int?      @default(10)
  expiry_alert_days   Int?      @default(30)
  business_hours      Json?
  settings            Json?
  created_at          DateTime? @default(now()) @db.Timestamp(6)
  updated_at          DateTime? @default(now()) @db.Timestamp(6)
}

model payments {
  id             Int       @id @default(autoincrement())
  sale_id        Int?
  payment_method String?   @db.VarChar(30)
  amount         Decimal   @db.Decimal(10, 2)
  reference      String?   @db.VarChar(100)
  status         String?   @default("completed") @db.VarChar(20)
  card_last4     String?   @db.VarChar(4)
  card_brand     String?   @db.VarChar(20)
  transaction_id String?   @db.VarChar(100)
  notes          String?
  created_at     DateTime? @default(now()) @db.Timestamp(6)
  sales          sales?    @relation(fields: [sale_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([sale_id], map: "idx_payments_sale_id")
}

model product_interactions {
  id                     Int       @id @default(autoincrement())
  product_id             Int?
  interacting_product_id Int?
  interaction_type       String?   @db.VarChar(50)
  severity               String?   @db.VarChar(20)
  description            String
  recommendations        String?
  source                 String?   @db.VarChar(100)
  created_at             DateTime? @default(now()) @db.Timestamp(6)

  @@unique([product_id, interacting_product_id, interaction_type])
}

model products {
  id                     Int       @id @default(autoincrement())
  name                   String    @db.VarChar(255)
  description            String?
  pricePPV               Decimal   @db.Decimal(10, 2)
  pricePPH               Decimal   @db.Decimal(10, 2)
  stock                  Int       @default(0)
  category               String?   @db.VarChar(100)
  sku                    String?   @unique @db.VarChar(50)
  imageUrl               String?
  expirationDate         DateTime? @db.Date
  createdAt              DateTime? @default(now()) @db.Timestamp(6)
  updatedAt              DateTime? @default(now()) @db.Timestamp(6)
  dosageForm             String?   @db.VarChar(50)
  barcode                String?   @unique @db.VarChar(100)
  zone                   String?   @db.VarChar(50)
  active                 Boolean?  @default(true)
  laboratory             String?   @db.VarChar(100)
  prescription           Boolean?  @default(false)
  posologyadult          String?
  posologychild          String?
  contraindications      String?
  monograph              String?
  code_atc               String?   @db.VarChar(20)
  composition            String?
  dosage                 String?   @db.VarChar(100)
  presentation           String?   @db.VarChar(255)
  princeps               Boolean?  @default(false)
  statut                 String?   @db.VarChar(50)
  tableau                String?   @db.VarChar(50)
  indications            String?
  substance_psychoactive Boolean?  @default(false)
  nature_produit         String?   @db.VarChar(100)
  classe_therapeutique   String?   @db.VarChar(100)
  distributeur           String?   @db.VarChar(255)
  mise_a_jour_le         DateTime? @db.Date
  ajoute_le              DateTime? @db.Date
  derniere_mise_a_jour   DateTime? @db.Timestamp(6)
  url_source             String?
  titulo_completo        String?
  nombre_original        String?   @db.VarChar(255)
}

model reports {
  id              Int       @id @default(autoincrement())
  report_type     String    @db.VarChar(50)
  report_date     DateTime  @db.Date
  period_start    DateTime? @db.Date
  period_end      DateTime? @db.Date
  generated_by    Int?
  filters         Json?
  data            Json?
  total_sales     Decimal?  @db.Decimal(10, 2)
  total_purchases Decimal?  @db.Decimal(10, 2)
  total_profit    Decimal?  @db.Decimal(10, 2)
  file_url        String?
  file_format     String?   @db.VarChar(10)
  status          String?   @default("generated") @db.VarChar(20)
  created_at      DateTime? @default(now()) @db.Timestamp(6)
  users           users?    @relation(fields: [generated_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model roles {
  id             Int          @id @default(autoincrement())
  name           String       @unique @db.VarChar(50)
  description    String?
  permissions    Json         @default("{}")
  is_system_role Boolean?     @default(false)
  created_at     DateTime?    @default(now()) @db.Timestamp(6)
  user_roles     user_roles[]
}

model sale_items {
  id                  Int       @id @default(autoincrement())
  sale_id             Int?
  product_id          Int?
  quantity            Int
  unit_price_ppv      Decimal   @db.Decimal(10, 2)
  unit_price_pph      Decimal   @db.Decimal(10, 2)
  discount_amount     Decimal?  @default(0) @db.Decimal(10, 2)
  discount_percentage Decimal?  @db.Decimal(5, 2)
  subtotal            Decimal?  @default(dbgenerated("((quantity)::numeric * unit_price_ppv)")) @db.Decimal(10, 2)
  total               Decimal?  @default(dbgenerated("(((quantity)::numeric * unit_price_ppv) - discount_amount)")) @db.Decimal(10, 2)
  margin              Decimal?  @default(dbgenerated("((unit_price_ppv - unit_price_pph) * (quantity)::numeric)")) @db.Decimal(10, 2)
  margin_percentage   Decimal?  @default(dbgenerated("\nCASE\n    WHEN (unit_price_ppv > (0)::numeric) THEN (((unit_price_ppv - unit_price_pph) / unit_price_ppv) * (100)::numeric)\n    ELSE (0)::numeric\nEND")) @db.Decimal(5, 2)
  lot_id              Int?
  expiration_date     DateTime? @db.Date
  notes               String?
  created_at          DateTime? @default(now()) @db.Timestamp(6)
  sales               sales?    @relation(fields: [sale_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model sales {
  id                     Int          @id @default(autoincrement())
  sale_number            String       @unique @db.VarChar(50)
  client_id              Int?
  user_id                Int
  subtotal               Decimal      @default(0) @db.Decimal(10, 2)
  discount_amount        Decimal?     @default(0) @db.Decimal(10, 2)
  discount_type          String?      @db.VarChar(20)
  discount_percentage    Decimal?     @db.Decimal(5, 2)
  tax_amount             Decimal?     @default(0) @db.Decimal(10, 2)
  total                  Decimal      @default(0) @db.Decimal(10, 2)
  paid_amount            Decimal      @default(0) @db.Decimal(10, 2)
  change_amount          Decimal?     @default(0) @db.Decimal(10, 2)
  payment_method         String?      @db.VarChar(30)
  payment_status         String?      @default("pending") @db.VarChar(20)
  sale_status            String?      @default("completed") @db.VarChar(20)
  notes                  String?
  adult_flag             Boolean?
  pregnant_flag          Boolean?
  lactating_flag         Boolean?
  chronic_condition_flag Boolean?
  usual_medication_flag  Boolean?
  created_at             DateTime?    @default(now()) @db.Timestamp(6)
  updated_at             DateTime?    @default(now()) @db.Timestamp(6)
  payments               payments[]
  sale_items             sale_items[]
  clients                clients?     @relation(fields: [client_id], references: [id], onUpdate: NoAction)
  users                  users        @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([client_id], map: "idx_sales_client_id")
  @@index([payment_status], map: "idx_sales_payment_status")
}

model settings {
  id            Int       @id @default(autoincrement())
  setting_key   String    @unique @db.VarChar(100)
  setting_value Json?
  setting_type  String?   @default("string") @db.VarChar(20)
  category      String?   @db.VarChar(50)
  description   String?
  is_public     Boolean?  @default(false)
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  updated_at    DateTime? @default(now()) @db.Timestamp(6)
}

model stock_movements {
  id                Int             @id @default(autoincrement())
  product_id        Int?
  lot_id            Int?
  movement_type     String?         @db.VarChar(30)
  quantity          Int
  previous_quantity Int?
  new_quantity      Int?
  unit_price_ppv    Decimal?        @db.Decimal(10, 2)
  unit_price_pph    Decimal?        @db.Decimal(10, 2)
  reference_id      Int?
  reference_type    String?         @db.VarChar(50)
  user_id           Int?
  notes             String?
  created_at        DateTime?       @default(now()) @db.Timestamp(6)
  inventory_lots    inventory_lots? @relation(fields: [lot_id], references: [id], onUpdate: NoAction)
  users             users?          @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model suppliers {
  id                 Int              @id @default(autoincrement())
  name               String           @db.VarChar(255)
  tax_id             String?          @db.VarChar(50)
  contact_person     String?          @db.VarChar(100)
  email              String?          @db.VarChar(255)
  phone              String?          @db.VarChar(20)
  address            String?
  payment_terms      String?
  is_active          Boolean?         @default(true)
  total_purchases    Decimal?         @default(0) @db.Decimal(10, 2)
  last_purchase_date DateTime?        @db.Timestamp(6)
  notes              String?
  created_at         DateTime?        @default(now()) @db.Timestamp(6)
  updated_at         DateTime?        @default(now()) @updatedAt @db.Timestamp(6)
  delivery_notes     delivery_notes[]
}

model user_roles {
  user_id                             Int
  role_id                             Int
  assigned_at                         DateTime? @default(now()) @db.Timestamp(6)
  assigned_by                         Int?
  users_user_roles_assigned_byTousers users?    @relation("user_roles_assigned_byTousers", fields: [assigned_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  roles                               roles     @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_user_roles_user_idTousers     users     @relation("user_roles_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, role_id])
}

model users {
  id                                       Int               @id @default(autoincrement())
  email                                    String            @unique @db.VarChar(255)
  password                                 String?            @db.VarChar(255) 
  full_name                                String?           @db.VarChar(255)
  google_id                                String?           @unique @db.VarChar(255)
  picture_url                              String?
  role                                     String?           @default("employee") @db.VarChar(50)
  is_active                                Boolean?          @default(true)
  last_login                               DateTime?         @db.Timestamp(6)
  created_at                               DateTime?         @default(now()) @db.Timestamp(6)
  updated_at                               DateTime?         @default(now()) @db.Timestamp(6)
  delivery_notes                           delivery_notes[]
  employees                                employees[]
  exchanges                                exchanges[]
  logs                                     logs[]
  reports                                  reports[]
  sales                                    sales[]
  stock_movements                          stock_movements[]
  user_roles_user_roles_assigned_byTousers user_roles[]      @relation("user_roles_assigned_byTousers")
  user_roles_user_roles_user_idTousers     user_roles[]      @relation("user_roles_user_idTousers")
}

model price_history {
  id         Int      @id @default(autoincrement())
  product_id Int
  date       DateTime @default(now()) @db.Timestamp(6)
  priceppv   Decimal  @db.Decimal(10, 2)
  pricepph   Decimal  @db.Decimal(10, 2)
}

model session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
}
