generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model AdminLog {
  id          Int             @id @default(autoincrement())
  admin_id    Int
  action      AdminActionType
  target_type String
  target_id   Int
  details     Json?
  ip_address  String?
  user_agent  String?
  created_at  DateTime        @default(now())
  users       users           @relation(fields: [admin_id], references: [id])

  @@index([action])
  @@index([admin_id])
  @@index([created_at])
}

model PaymentLog {
  id              Int           @id @default(autoincrement())
  subscription_id Int
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("MAD")
  payment_method  String
  status          PaymentStatus @default(PENDING)
  transaction_id  String?       @unique
  invoice_url     String?
  error_message   String?
  paid_at         DateTime?
  created_at      DateTime      @default(now())
  Subscription    Subscription  @relation(fields: [subscription_id], references: [id], onDelete: Cascade)

  @@index([created_at])
  @@index([status])
}

model Subscription {
  id                 Int                  @id @default(autoincrement())
  pharmacy_id        Int                  @unique
  plan               SubscriptionPlan     @default(BASIC)
  status             SubscriptionStatus   @default(TRIAL)
  start_date         DateTime             @default(now())
  end_date           DateTime
  next_billing_date  DateTime?
  trial_end_date     DateTime?
  created_at         DateTime             @default(now())
  updated_at         DateTime
  PaymentLog         PaymentLog[]
  SystemNotification SystemNotification[]
  pharmacy           pharmacy?

  @@index([end_date])
  @@index([status])
}

model SystemNotification {
  id              Int                @id @default(autoincrement())
  target          NotificationTarget @default(ALL)
  pharmacy_id     Int?
  title           String
  message         String
  action_url      String?
  is_read         Boolean            @default(false)
  read_by         Json?
  sent_at         DateTime           @default(now())
  expires_at      DateTime?
  created_by      Int
  subscription_id Int?
  users           users              @relation(fields: [created_by], references: [id])
  pharmacy        pharmacy?          @relation(fields: [pharmacy_id], references: [id])
  Subscription    Subscription?      @relation(fields: [subscription_id], references: [id])

  @@index([is_read])
  @@index([pharmacy_id])
  @@index([sent_at])
  @@index([target])
}

model ai_generated_messages {
  id          Int       @id @default(autoincrement())
  tone        String    @db.VarChar(20)
  message     String
  product_id  Int?
  points_cost Int?
  usage_count Int?      @default(0)
  like_count  Int?      @default(0)
  created_by  Int?
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  users       users?    @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  products    products? @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([product_id], map: "idx_ai_messages_product")
}

model client_consent {
  id                 Int       @id @default(autoincrement())
  client_id          Int?      @unique
  whatsapp           Boolean?  @default(true)
  email              Boolean?  @default(true)
  sms                Boolean?  @default(true)
  unsubscribed_at    DateTime? @db.Timestamp(6)
  unsubscribe_reason String?
  unsubscribe_token  String?   @unique @db.VarChar(100)
  created_at         DateTime? @default(now()) @db.Timestamp(6)
  clients            clients?  @relation(fields: [client_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([client_id], map: "idx_client_consent_client")
}

model client_debts {
  id                Int       @id @default(autoincrement())
  client_id         Int
  total_debt        Decimal   @default(0) @db.Decimal(10, 2)
  paid_amount       Decimal   @default(0) @db.Decimal(10, 2)
  last_payment_date DateTime? @db.Timestamp(6)
  status            String?   @default("pending") @db.VarChar(20)
  notes             String?
  created_at        DateTime? @default(now()) @db.Timestamp(6)
  updated_at        DateTime? @default(now()) @db.Timestamp(6)
  pending_amount    Decimal?  @default(dbgenerated("(total_debt - paid_amount)")) @db.Decimal(10, 2)
  clients           clients   @relation(fields: [client_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([client_id], map: "idx_client_debts_client_id")
}

model clients {
  id                   Int                    @id @default(autoincrement())
  pharmacy_id          Int
  first_name           String                 @db.VarChar(100)
  last_name            String                 @db.VarChar(100)
  email                String?                @db.VarChar(255)
  phone                String?                @db.VarChar(20)
  dni                  String?                @unique @db.VarChar(20)
  address              String?
  birth_date           DateTime?              @db.Date
  allergies            String?
  chronic_conditions   String?
  is_pregnant          Boolean?               @default(false)
  is_lactating         Boolean?               @default(false)
  loyalty_points       Int?                   @default(0)
  total_purchases      Decimal?               @default(0) @db.Decimal(10, 2)
  last_purchase_date   DateTime?              @db.Timestamp(6)
  favorite             Boolean?               @default(false)
  notes                String?
  created_at           DateTime?              @default(now()) @db.Timestamp(6)
  updated_at           DateTime?              @default(now()) @db.Timestamp(6)
  client_consent       client_consent?
  client_debts         client_debts[]
  pharmacy             pharmacy               @relation(fields: [pharmacy_id], references: [id], onDelete: Cascade)
  health_records       health_records[]
  loyalty_transactions loyalty_transactions[]
  message_recipients   message_recipients[]
  sales                sales[]

  @@index([pharmacy_id])
}

model credit_notes {
  id               String    @id @db.VarChar(255)
  supplier_id      String    @db.VarChar(255)
  reference        String    @unique @db.VarChar(50)
  issue_date       DateTime  @db.Date
  total_amount     Decimal   @db.Decimal(10, 2)
  used_amount      Decimal?  @default(0) @db.Decimal(10, 2)
  remaining_amount Decimal?  @default(0) @db.Decimal(10, 2)
  status           String    @db.VarChar(20)
  reason           String    @db.VarChar(50)
  linked_bl        String?   @db.VarChar(50)
  notes            String?
  created_at       DateTime? @default(now()) @db.Timestamp(6)
  updated_at       DateTime? @default(now()) @db.Timestamp(6)
  suppliers        suppliers @relation(fields: [supplier_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([status], map: "idx_credit_notes_status")
  @@index([supplier_id], map: "idx_credit_notes_supplier")
}

model delivery_note_items {
  id                Int            @id @default(autoincrement())
  delivery_note_id  Int
  product_id        Int
  quantity          Int
  unit_cost_pph     Decimal        @db.Decimal(10, 2)
  suggested_ppv     Decimal?       @db.Decimal(10, 2)
  expiration_date   DateTime       @db.Date
  batch_number      String?        @db.VarChar(100)
  subtotal          Decimal?       @db.Decimal(10, 2)
  margin_percentage Decimal?       @db.Decimal(5, 2)
  notes             String?
  created_at        DateTime?      @default(now()) @db.Timestamp(6)
  delivery_notes    delivery_notes @relation(fields: [delivery_note_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products          products       @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model delivery_notes {
  id                  Int                   @id @default(autoincrement())
  note_number         String                @unique @db.VarChar(50)
  supplier_id         String                @db.VarChar(255)
  bl_number           String?               @db.VarChar(100)
  reception_date      DateTime              @db.Date
  total_amount        Decimal?              @default(0) @db.Decimal(10, 2)
  total_items         Int?                  @default(0)
  payment_status      String?               @default("pending") @db.VarChar(20)
  is_paid             Boolean?              @default(false)
  paid_amount         Decimal?              @default(0) @db.Decimal(10, 2)
  paid_date           DateTime?             @db.Timestamp(6)
  notes               String?
  received_by         Int?
  created_at          DateTime?             @default(now()) @db.Timestamp(6)
  updated_at          DateTime?             @default(now()) @db.Timestamp(6)
  delivery_note_items delivery_note_items[]
  payment_obligations payment_obligations?
}

model employees {
  id                                                                  Int                   @id @default(autoincrement())
  user_id                                                             Int                   @unique
  pharmacy_id                                                         Int
  default_shift_id                                                    Int?
  vacation_days                                                       Float                 @default(25)
  vacation_days_used                                                  Float                 @default(0)
  created_at                                                          DateTime              @default(now())
  updated_at                                                          DateTime              @default(now())
  phone                                                               String?               @db.VarChar(50)
  address                                                             String?
  cni                                                                 String?               @unique @db.VarChar(50)
  birth_date                                                          DateTime?             @db.Date
  marital_status                                                      String?               @db.VarChar(20)
  children_count                                                      Int?                  @default(0)
  shifts                                                              shifts?               @relation(fields: [default_shift_id], references: [id])
  pharmacy                                                            pharmacy              @relation(fields: [pharmacy_id], references: [id], onDelete: Cascade)
  users                                                               users                 @relation(fields: [user_id], references: [id])
  shift_assignments                                                   shift_assignments[]
  shift_swap_requests_shift_swap_requests_from_employee_idToemployees shift_swap_requests[] @relation("shift_swap_requests_from_employee_idToemployees")
  shift_swap_requests_shift_swap_requests_to_employee_idToemployees   shift_swap_requests[] @relation("shift_swap_requests_to_employee_idToemployees")
  time_off_requests                                                   time_off_requests[]

  @@index([pharmacy_id])
}

model guard_schedules {
  id         Int      @id @default(autoincrement())
  shift_id   Int
  start_date DateTime
  end_date   DateTime
  created_at DateTime @default(now())
  updated_at DateTime @default(now())
  shifts     shifts   @relation(fields: [shift_id], references: [id], onDelete: Cascade)
}

model health_records {
  id                       Int       @id @default(autoincrement())
  client_id                Int
  glucose_level            Decimal?  @db.Decimal(5, 2)
  blood_pressure_systolic  Int?
  blood_pressure_diastolic Int?
  weight                   Decimal?  @db.Decimal(5, 2)
  heart_rate               Int?
  record_date              DateTime  @db.Date
  notes                    String?
  glucose_status           String?   @db.VarChar(20)
  blood_pressure_status    String?   @db.VarChar(20)
  heart_rate_status        String?   @db.VarChar(20)
  created_at               DateTime? @default(now()) @db.Timestamp(6)
  updated_at               DateTime? @default(now()) @db.Timestamp(6)
  clients                  clients   @relation(fields: [client_id], references: [id], onDelete: Cascade)

  @@index([client_id], map: "idx_health_records_client")
  @@index([record_date], map: "idx_health_records_date")
}

model holidays {
  id           Int      @id @default(autoincrement())
  pharmacy_id  Int
  name         String
  date         DateTime
  is_recurring Boolean  @default(false)
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now())
  pharmacy     pharmacy @relation(fields: [pharmacy_id], references: [id], onDelete: Cascade)

  @@index([pharmacy_id])
}

model inventory_lots {
  id              Int               @id @default(autoincrement())
  product_id      Int
  pharmacy_id     Int
  batch_number    String            @db.VarChar(100)
  expiry_date     DateTime          @db.Date
  quantity        Int
  created_at      DateTime?         @default(now()) @db.Timestamp(6)
  updated_at      DateTime?         @default(now()) @db.Timestamp(6)
  pharmacy        pharmacy          @relation(fields: [pharmacy_id], references: [id], onDelete: Cascade)
  products        products          @relation(fields: [product_id], references: [id], onUpdate: NoAction)
  stock_movements stock_movements[]

  @@unique([product_id, pharmacy_id, batch_number])
  @@index([expiry_date])
  @@index([pharmacy_id])
}

model loyalty_config {
  id                        Int       @id @default(autoincrement())
  pharmacy_id               Int       @unique
  points_per_unit           Int       @default(1)
  currency_unit             Int       @default(10)
  min_purchase_for_points   Decimal   @default(0) @db.Decimal(10, 2)
  points_expiry_days        Int       @default(365)
  welcome_points            Int       @default(100)
  birthday_multiplier       Decimal   @default(2.0) @db.Decimal(3, 1)
  first_purchase_multiplier Decimal   @default(1.5) @db.Decimal(3, 1)
  is_active                 Boolean   @default(true)
  tier_thresholds           Json?
  created_at                DateTime? @default(now()) @db.Timestamp(6)
  updated_at                DateTime? @default(now()) @db.Timestamp(6)
  pharmacy                  pharmacy  @relation(fields: [pharmacy_id], references: [id], onDelete: Cascade)
}

model loyalty_pack_products {
  pack_id       Int
  product_id    Int
  loyalty_packs loyalty_packs @relation(fields: [pack_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products      products      @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([pack_id, product_id])
}

model loyalty_packs {
  id                    Int                     @id @default(autoincrement())
  name                  String                  @db.VarChar(255)
  description           String?
  points_cost           Int
  is_active             Boolean?                @default(true)
  image_url             String?                 @db.VarChar(255)
  max_quantity          Int?
  start_date            DateTime?               @db.Timestamp(6)
  end_date              DateTime?               @db.Timestamp(6)
  created_at            DateTime?               @default(now()) @db.Timestamp(6)
  updated_at            DateTime?               @default(now()) @db.Timestamp(6)
  loyalty_pack_products loyalty_pack_products[]
  loyalty_transactions  loyalty_transactions[]

  @@index([is_active], map: "idx_loyalty_packs_active")
}

model loyalty_rewards {
  id                   Int                    @id @default(autoincrement())
  product_id           Int
  points_cost          Int
  is_active            Boolean?               @default(true)
  description          String?
  image_url            String?                @db.VarChar(255)
  max_quantity         Int?
  start_date           DateTime?              @db.Timestamp(6)
  end_date             DateTime?              @db.Timestamp(6)
  created_at           DateTime?              @default(now()) @db.Timestamp(6)
  updated_at           DateTime?              @default(now()) @db.Timestamp(6)
  products             products               @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  loyalty_transactions loyalty_transactions[]

  @@index([is_active], map: "idx_loyalty_rewards_active")
  @@index([product_id], map: "idx_loyalty_rewards_product")
}

model loyalty_transactions {
  id              Int              @id @default(autoincrement())
  client_id       Int
  points          Int
  type            String           @db.VarChar(50)
  reason          String?
  sale_id         Int?
  reward_id       Int?
  pack_id         Int?
  product_value   Decimal?         @db.Decimal(10, 2)
  created_at      DateTime?        @default(now()) @db.Timestamp(6)
  clients         clients          @relation(fields: [client_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  loyalty_packs   loyalty_packs?   @relation(fields: [pack_id], references: [id], onUpdate: NoAction)
  loyalty_rewards loyalty_rewards? @relation(fields: [reward_id], references: [id], onUpdate: NoAction)
  sales           sales?           @relation(fields: [sale_id], references: [id], onUpdate: NoAction)

  @@index([client_id], map: "idx_loyalty_transactions_client")
  @@index([created_at], map: "idx_loyalty_transactions_created")
  @@index([sale_id], map: "idx_loyalty_transactions_sale")
}

model message_campaigns {
  id                 Int                  @id @default(autoincrement())
  pharmacy_id        Int
  name               String               @db.VarChar(100)
  template_id        Int?
  segments           Json
  total_recipients   Int?                 @default(0)
  sent_count         Int?                 @default(0)
  delivered_count    Int?                 @default(0)
  read_count         Int?                 @default(0)
  conversion_count   Int?                 @default(0)
  conversion_value   Decimal?             @default(0) @db.Decimal(10, 2)
  status             String?              @default("draft") @db.VarChar(20)
  scheduled_for      DateTime?            @db.Timestamp(6)
  sent_at            DateTime?            @db.Timestamp(6)
  completed_at       DateTime?            @db.Timestamp(6)
  created_by         Int?
  created_at         DateTime?            @default(now()) @db.Timestamp(6)
  updated_at         DateTime?            @default(now()) @db.Timestamp(6)
  users              users?               @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pharmacy           pharmacy             @relation(fields: [pharmacy_id], references: [id], onDelete: Cascade)
  message_templates  message_templates?   @relation(fields: [template_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  message_recipients message_recipients[]

  @@index([status], map: "idx_message_campaigns_status")
  @@index([pharmacy_id])
}

model message_recipients {
  id                 Int                @id @default(autoincrement())
  client_id          Int?
  campaign_id        Int?
  phone              String?            @db.VarChar(20)
  message            String?
  status             String?            @default("pending") @db.VarChar(20)
  sent_at            DateTime?          @db.Timestamp(6)
  delivered_at       DateTime?          @db.Timestamp(6)
  read_at            DateTime?          @db.Timestamp(6)
  converted_at       DateTime?          @db.Timestamp(6)
  conversion_sale_id Int?
  created_at         DateTime?          @default(now()) @db.Timestamp(6)
  message_campaigns  message_campaigns? @relation(fields: [campaign_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  clients            clients?           @relation(fields: [client_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sales              sales?             @relation(fields: [conversion_sale_id], references: [id], onUpdate: NoAction)

  @@index([campaign_id], map: "idx_message_recipients_campaign")
  @@index([client_id], map: "idx_message_recipients_client")
  @@index([status], map: "idx_message_recipients_status")
}

model message_templates {
  id                Int                 @id @default(autoincrement())
  pharmacy_id       Int
  name              String              @db.VarChar(100)
  content           String
  variables         Json?
  status            String?             @default("draft") @db.VarChar(20)
  category          String?             @db.VarChar(50)
  created_by        Int?
  created_at        DateTime?           @default(now()) @db.Timestamp(6)
  updated_at        DateTime?           @default(now()) @db.Timestamp(6)
  message_campaigns message_campaigns[]
  users             users?              @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pharmacy          pharmacy            @relation(fields: [pharmacy_id], references: [id], onDelete: Cascade)

  @@index([status], map: "idx_message_templates_status")
  @@index([pharmacy_id])
}

model obligation_payments {
  id                  Int                 @id @default(autoincrement())
  obligation_id       Int
  amount              Decimal             @db.Decimal(10, 2)
  payment_method      String              @db.VarChar(30)
  reference           String?             @db.VarChar(100)
  payment_date        DateTime?           @default(now()) @db.Timestamp(6)
  notes               String?
  created_at          DateTime?           @default(now()) @db.Timestamp(6)
  payment_obligations payment_obligations @relation(fields: [obligation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model payment_obligations {
  id                  Int                   @id @default(autoincrement())
  delivery_note_id    Int                   @unique
  supplier_id         String                @db.VarChar(255)
  total_amount        Decimal               @db.Decimal(10, 2)
  paid_amount         Decimal?              @default(0) @db.Decimal(10, 2)
  pending_amount      Decimal               @db.Decimal(10, 2)
  due_date            DateTime              @db.Date
  status              String?               @default("pending") @db.VarChar(20)
  payment_terms       String?               @db.VarChar(50)
  notes               String?
  created_at          DateTime?             @default(now()) @db.Timestamp(6)
  updated_at          DateTime?             @default(now()) @db.Timestamp(6)
  obligation_payments obligation_payments[]
  delivery_notes      delivery_notes        @relation(fields: [delivery_note_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  suppliers           suppliers             @relation(fields: [supplier_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model payments {
  id             Int       @id @default(autoincrement())
  sale_id        Int
  amount         Decimal   @db.Decimal(10, 2)
  payment_method String    @db.VarChar(30)
  reference      String?   @db.VarChar(100)
  status         String?   @default("completed") @db.VarChar(20)
  notes          String?
  created_at     DateTime? @default(now()) @db.Timestamp(6)
  sales          sales     @relation(fields: [sale_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([sale_id], map: "idx_payments_sale_id")
}

model pharmacy {
  id                 Int                  @id @default(autoincrement())
  name               String               @unique
  license            String               @unique
  address            String?
  phone              String?
  email              String?
  is_active          Boolean              @default(true)
  created_at         DateTime             @default(now())
  updated_at         DateTime
  subscription_id    Int?                 @unique
  SystemNotification SystemNotification[]
  clients            clients[]
  employees          employees[]
  holidays           holidays[]
  inventory_lots     inventory_lots[]
  loyalty_config     loyalty_config?
  message_campaigns  message_campaigns[]
  message_templates  message_templates[]
  Subscription       Subscription?        @relation(fields: [subscription_id], references: [id])
  sales              sales[]
  shifts             shifts[]
  stock_movements    stock_movements[]
  suppliers          suppliers[]
  users              users[]
}

model pharmacy_config_overrides {
  id                     Int      @id @default(autoincrement())
  shift_id               Int
  date                   DateTime
  min_employees_required Int
  created_at             DateTime @default(now())
  updated_at             DateTime @default(now())
  shifts                 shifts   @relation(fields: [shift_id], references: [id], onDelete: Cascade)

  @@unique([shift_id, date])
}

model pharmacy_configs {
  id                     Int      @id @default(autoincrement())
  shift_id               Int      @unique
  min_employees_required Int      @default(1)
  created_at             DateTime @default(now())
  updated_at             DateTime @default(now())
  shifts                 shifts   @relation(fields: [shift_id], references: [id], onDelete: Cascade)
}

model price_history {
  id         Int      @id @default(autoincrement())
  product_id Int
  date       DateTime @default(now()) @db.Timestamp(6)
  priceppv   Decimal  @db.Decimal(10, 2)
  pricepph   Decimal  @db.Decimal(10, 2)
  products   products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model product_purchases {
  id               String    @id @db.VarChar(255)
  supplier_id      String    @db.VarChar(255)
  product_id       Int
  purchase_date    DateTime  @db.Date
  quantity         Int
  price_pph        Decimal   @db.Decimal(10, 2)
  previous_pph     Decimal?  @db.Decimal(10, 2)
  batch_number     String?   @db.VarChar(100)
  expiry_date      DateTime? @db.Date
  delivery_note_id String?   @db.VarChar(50)
  created_at       DateTime? @default(now()) @db.Timestamp(6)
  products         products  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  suppliers        suppliers @relation(fields: [supplier_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([purchase_date], map: "idx_product_purchases_date")
  @@index([product_id], map: "idx_product_purchases_product")
  @@index([supplier_id], map: "idx_product_purchases_supplier")
}

model products {
  id                     Int                     @id @default(autoincrement())
  name                   String                  @db.VarChar(255)
  description            String?
  pricePPV               Decimal                 @db.Decimal(10, 2)
  pricePPH               Decimal                 @db.Decimal(10, 2)
  stock                  Int                     @default(0)
  category               String?                 @db.VarChar(100)
  sku                    String?                 @unique @db.VarChar(50)
  imageUrl               String?
  expirationDate         DateTime?               @db.Date
  createdAt              DateTime?               @default(now()) @db.Timestamp(6)
  updatedAt              DateTime?               @default(now()) @db.Timestamp(6)
  dosageForm             String?                 @db.VarChar(50)
  barcode                String?                 @unique(map: "products_barcode_unique", where: raw("(barcode IS NOT NULL)")) @db.VarChar(100)
  zone                   String?                 @db.VarChar(50)
  active                 Boolean?                @default(true)
  laboratory             String?                 @db.VarChar(100)
  prescription           Boolean?                @default(false)
  posologyadult          String?
  posologychild          String?
  contraindications      String?
  monograph              String?
  code_atc               String?                 @db.VarChar(20)
  composition            String?
  dosage                 String?                 @db.VarChar(100)
  presentation           String?                 @db.VarChar(255)
  princeps               Boolean?                @default(false)
  statut                 String?                 @db.VarChar(50)
  tableau                String?                 @db.VarChar(50)
  indications            String?
  substance_psychoactive Boolean?                @default(false)
  nature_produit         String?                 @db.VarChar(100)
  classe_therapeutique   String?                 @db.VarChar(100)
  distributeur           String?                 @db.VarChar(255)
  mise_a_jour_le         DateTime?               @db.Date
  ajoute_le              DateTime?               @db.Date
  derniere_mise_a_jour   DateTime?               @db.Timestamp(6)
  url_source             String?
  titulo_completo        String?
  nombre_original        String?                 @db.VarChar(255)
  ai_generated_messages  ai_generated_messages[]
  delivery_note_items    delivery_note_items[]
  inventory_lots         inventory_lots[]
  loyalty_pack_products  loyalty_pack_products[]
  loyalty_rewards        loyalty_rewards[]
  price_history          price_history[]
  product_purchases      product_purchases[]
  sale_items             sale_items[]
  stock_movements        stock_movements[]
}

model sale_items {
  id                  Int       @id @default(autoincrement())
  sale_id             Int
  product_id          Int
  quantity            Int
  unit_price_ppv      Decimal   @db.Decimal(10, 2)
  unit_price_pph      Decimal   @db.Decimal(10, 2)
  discount_amount     Decimal?  @default(0) @db.Decimal(10, 2)
  discount_percentage Decimal?  @db.Decimal(5, 2)
  lot_id              Int?
  expiration_date     DateTime? @db.Date
  notes               String?
  created_at          DateTime? @default(now()) @db.Timestamp(6)
  subtotal            Decimal   @default(0) @db.Decimal(10, 2)
  total               Decimal   @default(0) @db.Decimal(10, 2)
  margin              Decimal   @default(0) @db.Decimal(10, 2)
  margin_percentage   Decimal   @default(0) @db.Decimal(5, 2)
  products            products  @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sales               sales     @relation(fields: [sale_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model sales {
  id                     Int                    @id @default(autoincrement())
  pharmacy_id            Int
  sale_number            String                 @unique @db.VarChar(50)
  client_id              Int?
  user_id                Int
  subtotal               Decimal                @db.Decimal(10, 2)
  discount_amount        Decimal?               @default(0) @db.Decimal(10, 2)
  discount_type          String?                @db.VarChar(20)
  discount_percentage    Decimal?               @db.Decimal(5, 2)
  tax_amount             Decimal?               @default(0) @db.Decimal(10, 2)
  total                  Decimal                @db.Decimal(10, 2)
  paid_amount            Decimal?               @default(0) @db.Decimal(10, 2)
  change_amount          Decimal?               @default(0) @db.Decimal(10, 2)
  payment_method         String?                @db.VarChar(30)
  payment_status         String?                @default("pending") @db.VarChar(20)
  sale_status            String?                @default("completed") @db.VarChar(20)
  notes                  String?
  adult_flag             Boolean?
  pregnant_flag          Boolean?
  lactating_flag         Boolean?
  chronic_condition_flag Boolean?
  usual_medication_flag  Boolean?
  amount_applied         Decimal?               @default(0) @db.Decimal(10, 2)
  amount_pending         Decimal?               @default(0) @db.Decimal(10, 2)
  is_debt_paid           Boolean?               @default(false)
  created_at             DateTime?              @default(now()) @db.Timestamp(6)
  updated_at             DateTime?              @default(now()) @db.Timestamp(6)
  loyalty_transactions   loyalty_transactions[]
  message_recipients     message_recipients[]
  payments               payments[]
  sale_items             sale_items[]
  clients                clients?               @relation(fields: [client_id], references: [id], onUpdate: NoAction)
  pharmacy               pharmacy               @relation(fields: [pharmacy_id], references: [id], onDelete: Cascade)
  users                  users                  @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([client_id])
  @@index([payment_status])
  @@index([pharmacy_id])
}

model session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
}

model shift_assignments {
  id          Int       @id @default(autoincrement())
  employee_id Int
  shift_id    Int
  date        DateTime
  created_at  DateTime  @default(now())
  updated_at  DateTime  @default(now())
  employees   employees @relation(fields: [employee_id], references: [id])
  shifts      shifts    @relation(fields: [shift_id], references: [id])
}

model shift_swap_requests {
  id                                                        Int       @id @default(autoincrement())
  from_employee_id                                          Int
  to_employee_id                                            Int
  from_shift_id                                             Int
  to_shift_id                                               Int
  date                                                      DateTime
  status                                                    String    @default("pending")
  notes                                                     String?
  reviewed_by                                               Int?
  reviewed_at                                               DateTime?
  created_at                                                DateTime  @default(now())
  updated_at                                                DateTime  @default(now())
  employees_shift_swap_requests_from_employee_idToemployees employees @relation("shift_swap_requests_from_employee_idToemployees", fields: [from_employee_id], references: [id])
  shifts_shift_swap_requests_from_shift_idToshifts          shifts    @relation("shift_swap_requests_from_shift_idToshifts", fields: [from_shift_id], references: [id])
  employees_shift_swap_requests_to_employee_idToemployees   employees @relation("shift_swap_requests_to_employee_idToemployees", fields: [to_employee_id], references: [id])
  shifts_shift_swap_requests_to_shift_idToshifts            shifts    @relation("shift_swap_requests_to_shift_idToshifts", fields: [to_shift_id], references: [id])
}

model shifts {
  id                                                            Int                         @id @default(autoincrement())
  pharmacy_id                                                   Int
  name                                                          String
  start_time                                                    String
  end_time                                                      String
  is_guard                                                      Boolean                     @default(false)
  min_employees_required                                        Int                         @default(1)
  created_at                                                    DateTime                    @default(now())
  updated_at                                                    DateTime                    @default(now())
  color                                                         String?                     @default("#3B82F6") @db.VarChar(20)
  deleted_at                                                    DateTime?                   @db.Timestamp(6)
  employees                                                     employees[]
  guard_schedules                                               guard_schedules[]
  pharmacy_config_overrides                                     pharmacy_config_overrides[]
  pharmacy_configs                                              pharmacy_configs?
  shift_assignments                                             shift_assignments[]
  shift_swap_requests_shift_swap_requests_from_shift_idToshifts shift_swap_requests[]       @relation("shift_swap_requests_from_shift_idToshifts")
  shift_swap_requests_shift_swap_requests_to_shift_idToshifts   shift_swap_requests[]       @relation("shift_swap_requests_to_shift_idToshifts")
  pharmacy                                                      pharmacy                    @relation(fields: [pharmacy_id], references: [id], onDelete: Cascade)

  @@index([pharmacy_id])
}

model stock_movements {
  id             Int             @id @default(autoincrement())
  product_id     Int
  pharmacy_id    Int
  lot_id         Int?
  type           String          @db.VarChar(20)
  quantity       Int
  stock_after    Int
  notes          String?
  created_at     DateTime?       @default(now()) @db.Timestamp(6)
  user_id        Int?
  inventory_lots inventory_lots? @relation(fields: [lot_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pharmacy       pharmacy        @relation(fields: [pharmacy_id], references: [id], onDelete: Cascade)
  products       products        @relation(fields: [product_id], references: [id], onUpdate: NoAction)
  users          users?          @relation(fields: [user_id], references: [id])

  @@index([pharmacy_id])
  @@index([product_id])
}

model supplier_addresses {
  id            String    @id @db.VarChar(255)
  supplier_id   String    @db.VarChar(255)
  street_number String?   @db.VarChar(20)
  street_name   String    @db.VarChar(255)
  city          String    @db.VarChar(100)
  postal_code   String?   @db.VarChar(20)
  country       String?   @default("Maroc") @db.VarChar(100)
  complement    String?
  is_primary    Boolean?  @default(false)
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  updated_at    DateTime? @default(now()) @db.Timestamp(6)
  suppliers     suppliers @relation(fields: [supplier_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([supplier_id], map: "idx_supplier_addresses_supplier_id")
}

model supplier_phones {
  id          String    @id @db.VarChar(255)
  supplier_id String    @db.VarChar(255)
  number      String    @db.VarChar(50)
  type        String    @db.VarChar(20)
  description String?
  is_primary  Boolean?  @default(false)
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @default(now()) @db.Timestamp(6)
  suppliers   suppliers @relation(fields: [supplier_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([supplier_id, number])
  @@index([supplier_id], map: "idx_supplier_phones_supplier_id")
}

model suppliers {
  id                  String                @id @db.VarChar(255)
  pharmacy_id         Int
  company_name        String                @db.VarChar(255)
  email               String?               @db.VarChar(255)
  website             String?               @db.VarChar(255)
  fax                 String?               @db.VarChar(50)
  payment_terms       String?               @db.VarChar(100)
  tax_id              String?               @db.VarChar(50)
  registration_number String?               @db.VarChar(50)
  balance             Decimal?              @default(0) @db.Decimal(10, 2)
  is_active           Boolean?              @default(true)
  notes               String?
  created_at          DateTime?             @default(now()) @db.Timestamp(6)
  updated_at          DateTime?             @default(now()) @db.Timestamp(6)
  credit_notes        credit_notes[]
  payment_obligations payment_obligations[]
  product_purchases   product_purchases[]
  supplier_addresses  supplier_addresses[]
  supplier_phones     supplier_phones[]
  pharmacy            pharmacy              @relation(fields: [pharmacy_id], references: [id], onDelete: Cascade)

  @@index([pharmacy_id])
}

model time_off_requests {
  id               Int       @id @default(autoincrement())
  employee_id      Int
  start_date       DateTime
  end_date         DateTime
  type             String    @default("vacation")
  status           String    @default("pending")
  notes            String?
  reviewed_by      Int?
  reviewed_at      DateTime?
  coverage_warning Boolean   @default(false)
  coverage_details Json?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @default(now())
  employees        employees @relation(fields: [employee_id], references: [id])
}

model users {
  id                    Int                     @id @default(autoincrement())
  email                 String                  @unique
  full_name             String?
  password              String?
  role                  String                  @default("EMPLOYEE")
  is_active             Boolean                 @default(true)
  pharmacy_id           Int?
  created_at            DateTime                @default(now())
  updated_at            DateTime
  temp_password         String?
  temp_password_expires DateTime?               @db.Timestamp(6)
  AdminLog              AdminLog[]
  SystemNotification    SystemNotification[]
  absence_requests      absence_requests[]
  ai_generated_messages ai_generated_messages[]
  employees             employees?
  message_campaigns     message_campaigns[]
  message_templates     message_templates[]
  sales                 sales[]
  stock_movements       stock_movements[]
  pharmacy              pharmacy?               @relation(fields: [pharmacy_id], references: [id])
}

model absence_requests {
  id           String              @id @default(dbgenerated("(gen_random_uuid())::text"))
  employeeId   Int
  type         absence_type_enum
  startDate    DateTime
  endDate      DateTime
  reason       String?
  adminComment String?
  status       request_status_enum @default(PENDING)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @default(now())
  users        users               @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_absence_requests_employee")

  @@index([employeeId, status, startDate, endDate], map: "idx_absence_requests_employee_status_dates")
  @@index([employeeId], map: "idx_absence_requests_employeeid")
  @@index([status], map: "idx_absence_requests_status")
}

enum AdminActionType {
  IMPERSONATE
  EXTEND_COURTESY
  RENEW_LICENSE
  SUSPEND_PHARMACY
  ACTIVATE_PHARMACY
  SEND_BROADCAST
  UPDATE_SUBSCRIPTION
}

enum NotificationTarget {
  ALL
  SPECIFIC_PHARMACY
  INACTIVE
  ACTIVE
  GRACE_PERIOD
  SUSPENDED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum SubscriptionPlan {
  BASIC
  PREMIUM
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  GRACE_PERIOD
  SUSPENDED
  CANCELLED
}

enum absence_type_enum {
  VACATION
  SICK_LEAVE
  MATERNITY_PATERNITY
  PERSONAL_AFFAIRS
}

enum request_status_enum {
  PENDING
  APPROVED
  REJECTED
}
